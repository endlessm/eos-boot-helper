# Timezone -> Country Code
tz=$(timedatectl show -p Timezone --value)
tab=$(printf '\t')
cc=$(grep "${tab}${tz}\$" /usr/share/zoneinfo/zone.tab 2>/dev/null | cut -f1 | head -n1)

if expr "$cc" : '^[A-Z][A-Z]$' >/dev/null; then
    echo "set-regdom: Set regulation domain to $cc"
    iw reg set "$cc"
fi
